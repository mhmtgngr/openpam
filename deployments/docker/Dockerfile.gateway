# OpenPAM Gateway Service Dockerfile
# Multi-stage build for minimal image size

# Build stage
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates gcc musl-dev

WORKDIR /build

# Copy dependency files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the gateway service
# CGO_ENABLED=0 for static binary, -ldflags strips debug info
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-s -w -X main.version=latest -X main.buildTime=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    -o /app/gateway ./cmd/gateway

# Runtime stage
FROM alpine:3.19

# Install runtime dependencies
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    wget \
    && adduser -D -u 1000 -s /bin/sh appuser

# Copy binary from builder
COPY --from=builder /app/gateway /usr/local/bin/gateway

# Create directories for configuration and JWT keys
RUN mkdir -p /etc/openpam/jwt /etc/openpam/config \
    && chown -R appuser:appuser /etc/openpam

# Set permissions
USER appuser

# Expose port
EXPOSE 8500

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:8500/health || exit 1

# Run the application
CMD ["gateway"]
